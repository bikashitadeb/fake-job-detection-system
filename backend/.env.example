# Required production configuration
APP_ENV=production
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
JWT_SECRET_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
CORS_ORIGINS=https://FRONTEND_HOSTNAME

# Optional runtime configuration
CORS_SUPPORTS_CREDENTIALS=true
PORT=5000
LOG_LEVEL=INFO
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
JWT_ACCESS_TOKEN_HOURS=1
JWT_REFRESH_TOKEN_DAYS=30
JWT_DECODE_LEEWAY_SECONDS=10
PIPELINE_MODEL_PATH=
PIPELINE_VECTORIZER_PATH=
AI_VERIFICATION_MODEL_PATH=
AI_VERIFICATION_VECTORIZER_PATH=

# Used only by backend/migration/mysql_to_mongodb.py
MYSQL_PASSWORD=
MONGO_URI=
